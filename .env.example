APP_NAME=ecom-be
ENVIRONMENT=development

# Replace both placeholders with the URL of your own local services.
# Format only -- never commit a real connection string or credential.
DATABASE_URL=<replace-with-local-postgresql-url>
REDIS_URL=<replace-with-local-redis-url>

CORS_ORIGINS=["http://localhost:3000"]

# Optional: host ports published by compose.yaml. The defaults keep this
# project's disposable services off the usual 5432/6379 ports.
# POSTGRES_DB=ecommerce
# POSTGRES_USER=app
# POSTGRES_PASSWORD=app
# POSTGRES_PORT=55432
# REDIS_PORT=56379

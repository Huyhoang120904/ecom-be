APP_NAME=ecom-be
ENVIRONMENT=development

# Replace both placeholders with the URL of your own local services.
# Format only -- never commit a real connection string or credential.
DATABASE_URL=<replace-with-local-postgresql-url>
REDIS_URL=<replace-with-local-redis-url>

CORS_ORIGINS=["http://localhost:3000"]

# Signing secret for access tokens. Required, and at least 32 characters: a short
# secret refuses startup rather than quietly weakening every token. Generate one
# with `openssl rand -base64 48` and never commit the real value.
JWT_SECRET=<replace-with-at-least-32-random-characters>

# Token lifetimes in seconds. 900 is 15 minutes; 2592000 is 30 days.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Everything above is an application setting: `Settings` parses this file and
# rejects unknown keys, so nothing else may be added here.
#
# Compose-only values (POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD,
# POSTGRES_PORT, REDIS_PORT) are NOT application settings and must never be
# written into this file -- doing so makes the app fail to start with a
# `ValidationError: postgres_port Extra inputs are not permitted`.
# They live in `compose.env.example`; see README.md -> Local services.

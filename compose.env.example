# Compose-only environment for ecom-be.
#
# These values are interpolated by `docker compose` and are NOT application
# settings: `Settings` forbids unknown keys, so writing any of them into `.env`
# makes the application fail to start with a `ValidationError`. Keep them here.
#
# Use them with an explicit env file:
#
#   cp compose.env.example compose.env
#   docker compose --env-file compose.env up -d --wait
#
# `--env-file` replaces the default `.env` for interpolation only; the
# application itself still reads `.env` through `Settings`. Without the flag,
# `docker compose up -d --wait` uses the defaults below, which already keep
# this project off the usual 5432/6379 ports.
#
# These are disposable local-development values. Never reuse them outside a
# throwaway developer machine, and never commit `compose.env`.

# PostgreSQL container identity created on first start.
POSTGRES_DB=ecommerce
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Host ports published by compose.yaml. Change them when 55432/56379 are taken.
POSTGRES_PORT=55432
REDIS_PORT=56379

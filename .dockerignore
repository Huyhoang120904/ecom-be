# Keep the build context small; the Dockerfile only needs project metadata,
# the lock file, and the application source.
.git/
.github/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
__pycache__/
*.py[cod]

# Never copy local environment files or editor state into an image.
.env
.env.*
!.env.example

tests/
docs/

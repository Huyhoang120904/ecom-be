# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/

# Environment files
.env
.env.*
!.env.example
# Compose-only variables: `.env` is parsed by `Settings`, which forbids unknown
# keys, so compose overrides live in their own file (see compose.env.example).
compose.env

# Test, lint, and type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/

# Media storage. Local image objects live here; the directory is not committed.
.media/
